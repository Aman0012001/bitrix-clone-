# Copy this file to .env and replace the placeholders with your Neon connection strings.
# Use Neon's pooled URL (hostname includes "-pooler") for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Use Neon's direct, non-pooled URL for schema migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon CLI may also provide this direct URL as DATABASE_URL_UNPOOLED.

# Comma-separated allowed browser origins.
CORS_ORIGIN="http://localhost:5173"
PORT=3000
NODE_ENV=development
JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
JWT_ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional server-side Neon services. Replace placeholders before use.
NEON_AI_GATEWAY_BASE_URL="https://BRANCH-api.ai.REGION.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN="NEON_AI_GATEWAY_TOKEN_PLACEHOLDER"
NEON_REALTIME_URL="wss://REALTIME_HOST/"
NEON_REALTIME_SECRET="NEON_REALTIME_SECRET_PLACEHOLDER"
